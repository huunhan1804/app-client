<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:fitsSystemWindows="true"

    tools:context=".AgencyRegistrationStatusActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.MaterialComponents.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_app"
            app:popupTheme="@style/Theme.MaterialComponents.PopupOverlay"
            app:title="Trạng thái xét duyệt"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_status_result_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/img_status_icon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="24dp"
                        android:contentDescription="Status Icon"
                        tools:src="@drawable/ic_status_approved" />

                    <TextView
                        android:id="@+id/tv_status_main_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center"
                        android:text="Tình trạng:"
                        android:textColor="#333333"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_status_sub_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="Hồ sơ đăng ký của bạn đang được đội ngũ của chúng tôi kiểm tra. Quá trình này có thể mất từ 24-48 giờ làm việc."
                        android:textColor="#777777"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <Button
                        android:id="@+id/btn_view_rejection_reason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="#FFEBEE"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="12dp"
                        android:text="Xem lý do từ chối"
                        android:textColor="#FF0000"
                        android:visibility="gone"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btn_reapply"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="@color/pharmacy_secondary"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="12dp"
                        android:text="Đăng ký lại"
                        android:textColor="@android:color/white"
                        android:visibility="gone"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btn_refresh_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="#E0E0E0"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="12dp"
                        android:text="Kiểm tra lại trạng thái"
                        android:textColor="#333333"
                        android:visibility="gone"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btn_go_to_agency_channel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Vào Kênh Người Bán"
                        android:visibility="gone" />
                    <Button
                        android:id="@+id/btn_go_to_homepage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Quay lại màn hình chính"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_contact_support"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/ic_launcher_background"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="12dp"
                        android:text="Liên hệ hỗ trợ"
                        android:textColor="@android:color/white"
                        android:visibility="gone"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Không tìm thấy thông tin đăng ký với mã đã nhập. Vui lòng kiểm tra lại email/số điện thoại."
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_initial_loading_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="Đang tải trạng thái đăng ký của bạn..."
                android:textColor="#555555"
                android:textSize="16sp"
                android:visibility="visible" />

            <ProgressBar
                android:id="@+id/pb_loading_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="visible" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>