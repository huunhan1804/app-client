<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thiết lập thuộc tính sản phẩm"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/llAttributeInputsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnAddAttribute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thêm thuộc tính"
            android:layout_gravity="end"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <Button
            android:id="@+id/btnGenerateVariants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo biến thể"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:backgroundTint="@color/color_app"
            android:textColor="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Các biến thể đã tạo"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <TableLayout
            android:id="@+id/tlVariantInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*">
        </TableLayout>

        <TextView
            android:id="@+id/tvNoVariantsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vui lòng thêm thuộc tính và nhấn 'Tạo biến thể'."
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="visible"/>
    </LinearLayout>
</ScrollView>