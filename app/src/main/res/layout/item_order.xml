<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="8dp"
    card_view:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/iv_order_product"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Product Image"
            android:src="@drawable/product_image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_order_id"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Order ID: #12345"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_order_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date: 01/01/2023"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Order Status -->
            <TextView
                android:id="@+id/tv_order_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Status: PENDING_PAYMENT"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="14sp" />

            <!-- Order Details -->
            <TextView
                android:id="@+id/tv_order_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Details: 3 items, Total: $150"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_order_cancel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/color_app"
                    android:text="Cancel Order"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/btn_order_received"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã nhận"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/color_app"
                    android:textColor="@android:color/white"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn_order_return_refund"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trả hàng/Hoàn tiền"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/color_app"
                    android:textColor="@android:color/white"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn_order_reorder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mua lại"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/color_app"
                    android:textColor="@android:color/white"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn_order_view"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/color_app"
                    android:text="View Detail"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
